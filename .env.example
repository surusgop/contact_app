# --- Flask -----------------------------------------------------------------
# Long random string. Changing it signs everyone out.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=

# Signs the surus-auth session cookie. Separate from FLASK_SECRET_KEY and
# unique to this app -- a shared one would let another app's cookie
# authenticate here. Required; the app refuses to start without it.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# This app's public origin. No trailing slash. The Google redirect URI is
# always <APP_URL>/auth/callback and must be registered in the Google console.
APP_URL=http://localhost:5000

# --- Google OAuth ----------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Who may sign in -------------------------------------------------------
# Comma-separated domains. No "@", spaces are trimmed.
ALLOWED_EMAIL_DOMAIN=surusenterprises.com,americanstewardship.org

# Individual addresses outside those domains (contractors, Gmail). Optional.
ALLOWED_EMAILS=

# The first admins (comma-separated). Always admin; everyone else's role is
# set on /admin and kept in the shared team_members table.
ADMIN_BOOTSTRAP_EMAILS=

# --- Roles, usage tracking and /admin (surus-auth v2) ------------------------
# This app's key in the shared `apps` table. Optional: defaults to contact_app.
APP_ID=contact_app
# prod in production; dev, test or dev_<name> elsewhere. Unset means dev.
APP_ENV=dev
# Shared tables: universal.ops. Required when APP_ENV=prod. Leave it unset
# locally to keep roles and activity in memory (lost on restart).
PLATFORM_SCHEMA=

# --- Databricks ------------------------------------------------------------
# Used by the app (databricks-sdk) and by surus-auth for the shared tables.
DATABRICKS_HOST=
DATABRICKS_WAREHOUSE_ID=
# Sign in with ONE of:
#  - the app's service principal (production): application (client) ID and an
#    OAuth secret with scope all-apis; tokens are fetched and renewed for you
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
#  - or a personal access token (local runs). It wins when both are set, so
#    leave it out where the service principal should be used.
DATABRICKS_TOKEN=
# Optional. surus-auth needs the warehouse's HTTP path; when this is unset it
# is built from DATABRICKS_WAREHOUSE_ID as /sql/1.0/warehouses/<id>.
# DATABRICKS_HTTP_PATH=

# --- Other -----------------------------------------------------------------
OPENROUTER_API_KEY=
